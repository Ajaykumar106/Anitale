{
  "name": "anitale",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify:db": "npx prisma validate && npx prisma format",
    "verify": "npm run typecheck && npm run verify:db && npm run lint && npm run test && npm run build",
    "postinstall": "prisma skills sync || exit 0"
  },
