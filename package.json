    "@neon/env": "^1.3.4",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "ai": "^7.0.107",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
